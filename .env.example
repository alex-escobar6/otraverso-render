# OTRAVERSO: copiar a .env y ajustar antes de producción.
# Nunca subir .env ni data/ a control de versiones.

DATABASE_PATH=/home/sistemas/otraverso/data/otraverso.db
SECRET_KEY=cambiar-por-una-clave-aleatoria-de-al-menos-48-caracteres
BASE_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000
DEBUG=0
WHATIF_DEBUG=0
SESSION_HOURS=12
ADMIN_EMAIL=admin@ejemplo.local
ADMIN_PASSWORD=cambiar-contraseña-larga-y-única
WHATSAPP_DEFAULT=573000000000
MAX_UPLOAD_MB=8
CURRENCY=COP

# Render: DATABASE_URL y SECRET_KEY son obligatorios; no usar DATABASE_PATH ni HOST fijo.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/base
# PRODUCTION=1
# TRUST_PROXY=1
# RATE_LIMIT_PER_MINUTE=600
# LOG_TO_STDOUT=1
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=otraverso

# OTRAVERSO WHAT IF (opcional; sin estas claves el motor local funciona igual)
# WHATIF_API_KEY=
# WHATIF_IMAGE_API_KEY=
# Proveedor, modelo, URL, límites, modos, bloques por capítulo, longitudes, géneros, estilos, memoria, paleta visual y plantillas se configuran en /admin/what-if.
# WHATIF_DEBUG=1 habilita diagnóstico temporal (consola y data/whatif-api.log); dejar en 0 en producción.
# Nunca coloques claves de proveedores en el panel ni en el frontend.
